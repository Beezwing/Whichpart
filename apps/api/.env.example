# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already in .gitignore.

# Local Postgres, or a free Railway/Neon database URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autoparts_dev"

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=4000
WEB_APP_ORIGIN="http://localhost:3000"

# Used once by `npm run db:seed` to create the first Super Admin account.
# Admins are never self-registered — this is the only way one gets created.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-after-first-login"

# --- Added in later phases, not needed yet ---
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# MEILISEARCH_HOST=
# MEILISEARCH_API_KEY=
# RESEND_API_KEY=
# ANTHROPIC_API_KEY=
# SENTRY_DSN=
