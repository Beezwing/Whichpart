# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already in .gitignore.

# Local Postgres, or a free Railway/Neon database URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autoparts_dev"

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Encrypts supplier payment-provider API keys at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-a-64-character-hex-string"

PORT=4000
WEB_APP_ORIGIN="http://localhost:3000"
# Where DimePay's servers can reach ours to deliver a webhook -- the
# API's own public URL (e.g. your Railway domain + /api), not the web
# app's.
API_PUBLIC_URL="http://localhost:4000/api"

# Used once by `npm run db:seed` to create the first Super Admin account.
# Admins are never self-registered — this is the only way one gets created.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-after-first-login"

# --- Added in later phases, not needed yet ---
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# MEILISEARCH_HOST=
# MEILISEARCH_API_KEY=
# Powers new-order and order-status-update emails. Free tier works with
# zero setup using the onboarding@resend.dev sender below; verify your
# own domain with Resend later and change FROM_EMAIL to send as it.
# RESEND_API_KEY=
# FROM_EMAIL="Which Part? <onboarding@resend.dev>"
# ANTHROPIC_API_KEY=
# SENTRY_DSN=
#
# QuickBooks Online sync (Section: two-way inventory sync). Register an app
# at developer.intuit.com to get these; redirect URI to add there is
# API_PUBLIC_URL + "/quickbooks/callback". Leave unset and the feature is
# just unavailable -- nothing else breaks.
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENVIRONMENT="sandbox"
# The Webhooks Verifier Token from that same app -- required to trust an
# incoming webhook is really from Intuit and not a forged POST.
# QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=
