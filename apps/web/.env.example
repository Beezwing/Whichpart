# The browser always calls this app's own origin at /api -- see the
# rewrite in next.config.ts. This just tells that rewrite where the real
# API lives; only needed if it's not the default (local dev, port 4000).
# API_ORIGIN="http://localhost:4000"

# Used for the delivery pin-drop map at checkout. Needs the Maps
# JavaScript API + Geocoding API enabled on the Google Cloud project,
# and this app's domain added to the key's allowed HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
